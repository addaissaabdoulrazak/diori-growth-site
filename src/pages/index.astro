---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import SiteLayout from "@/layouts/SiteLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import ContactDetails from "@/components/ContactDetails.astro";
import Programs from "@/components/Programs.astro";
import portrait from "@/assets/malik-diori.png";
import { siteConfig } from "@/config/site";
export const prerender = true;
const services = (await getCollection("services", ({ data }) => data.featured && (siteConfig.preview || data.approvalStatus === "approved"))).sort((a,b) => a.data.order-b.data.order);
---
<SiteLayout title="Formation et développement commercial au Niger" description="DIORI GROWTH accompagne les entreprises à Niamey et au Niger : formation professionnelle, développement commercial, IA et numérique responsable.">
  <section class="hero"><div class="shell hero-grid">
    <div class="hero-copy">
      <div class="eyebrow">Cabinet de conseil & formation · Niamey, Niger</div>
      <h1 class="display">Grandir.<br />Performer.<br /><em>Transformer.</em></h1>
      <p>Des compétences, des experts et un accompagnement adapté pour faire avancer votre entreprise.</p>
      <p class="hero-description">Formation professionnelle, développement commercial et solutions responsables : DIORI GROWTH vous accompagne à partir de vos enjeux.</p>
      <div class="hero-actions"><a class="button button-gold" href="/contact/">Demander un programme et un devis <span aria-hidden="true">↗</span></a><a class="hero-text-link" href="/services/">Découvrir nos services <span aria-hidden="true">→</span></a></div>
      <p class="hero-note">Au Niger · Présentiel, à distance ou hybride selon le projet</p>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="orbit"><span class="orbit-dot"></span></div>
      <div class="art-core"><strong>DI</strong><span>Grandir · Performer · Transformer</span></div>
      <div class="art-label one">Compétences</div>
      <div class="art-label two">Expertises</div>
      <div class="art-label three">Croissance</div>
    </div>
  </div></section>
  <div class="trust-strip"><div class="shell trust-inner"><div class="trust-label">Un accompagnement au service de votre organisation.</div><div class="trust-chips"><span>Entreprises & PME</span><span>Organisations</span><span>Institutions</span><span>Professionnels</span></div></div></div>
  <section class="section-space"><div class="shell">
    <div class="section-heading"><div class="eyebrow">Nos domaines d'intervention</div><h2>Des solutions à la hauteur de vos enjeux.</h2><p>Développer les compétences, structurer l'action commerciale et faire évoluer les pratiques de votre organisation.</p></div>
    <div class="offer-grid pillar-grid">{services.map((service,index) => <article class="card offer-card">
      <span class="offer-number">0{index+1}</span>
      {service.data.approvalStatus === "draft" && <span class="preview-stamp">Proposition à valider</span>}
      <h3>{service.data.shortTitle}</h3><p>{service.data.summary}</p><div class="offer-footer"><a class="text-link" href={`/services/${service.id}/`}>Découvrir <span aria-hidden="true">↗</span></a></div>
    </article>)}</div>
  </div></section>
  <Programs />
  <section class="method section-space"><div class="shell">
    <div class="section-heading"><div class="eyebrow">Notre méthode</div><h2>Votre besoin donne le cap.</h2><p>Un interlocuteur pour construire la réponse et coordonner les compétences nécessaires à votre projet.</p></div>
    <div class="steps">
      <article class="step"><h3>Comprendre votre contexte</h3><p>Nous précisons vos objectifs, les participants et les contraintes à prendre en compte.</p></article>
      <article class="step"><h3>Construire une proposition</h3><p>Programme, format, durée et expertise sont étudiés ensemble. Les prestations d'entreprise sont proposées sur devis.</p></article>
      <article class="step"><h3>Mobiliser les compétences</h3><p>Nous coordonnons l'intervention d'experts locaux ou internationaux selon le périmètre et leurs disponibilités.</p></article>
    </div><div class="offer-footer"><a class="hero-text-link" href="/experts/">Rencontrer les experts et découvrir la méthode <span aria-hidden="true">↗</span></a></div>
  </div></section>
  <section class="section-space"><div class="shell about-band">
    <figure class="founder-portrait">
      <div class="founder-photo"><Image src={portrait} width={520} widths={[320,440,600]} sizes="(max-width: 720px) min(90vw, 384px), 36vw" format="webp" alt="Malik DIORI, directeur général de DIORI GROWTH" loading="lazy" /></div>
      <figcaption><span>Votre interlocuteur</span><strong>Malik DIORI</strong><span>Directeur général · DIORI GROWTH</span></figcaption>
    </figure>
    <div class="about-copy"><div class="eyebrow">À propos de DIORI GROWTH · Niamey</div><h2>Des entreprises plus compétitives et durables.</h2><p>Basé à Niamey, notre cabinet accompagne les entreprises, les organisations et les institutions au Niger dans le développement de leurs compétences et de leurs activités.</p><p>Malik DIORI, directeur général, est votre interlocuteur pour préparer votre projet et coordonner les expertises à mobiliser.</p><p>Excellence, engagement, impact, éthique et innovation guident la démarche présentée par DIORI GROWTH.</p><a class="text-link" href="/a-propos/">Découvrir le cabinet <span aria-hidden="true">↗</span></a></div>
  </div></section>
  <section class="section-space faq-section"><div class="shell">
    <div class="section-heading"><div class="eyebrow">Questions fréquentes</div><h2>Préparer votre prochain projet.</h2></div>
    <div class="faq-list">
      <details><summary>Le programme peut-il être adapté à notre équipe ?</summary><p>Oui. Corporate Training permet de définir les objectifs, le contenu, la durée et les modalités en fonction du contexte de votre entreprise.</p></details>
      <details><summary>Quels formats de formation proposez-vous ?</summary><p>En présentiel dans vos locaux ou dans un lieu convenu, à distance sur une plateforme adaptée, ou en hybride selon vos objectifs et les moyens disponibles.</p></details>
      <details><summary>Qui anime les formations ?</summary><p>Des formateurs, consultants ou experts nationaux ou internationaux sont mobilisés selon le besoin. Le cabinet coordonne le projet ; l'intervenant et sa disponibilité sont confirmés dans la proposition.</p></details>
      <details><summary>Comment connaître le tarif et les prochaines dates ?</summary><p>Les prestations d'entreprise sont principalement sur devis. Pour Expert Series, les dates, modalités et tarifs sont communiqués pour chaque édition confirmée. Contactez-nous pour étudier votre besoin.</p></details>
      <details><summary>Une évaluation est-elle prévue ?</summary><p>Les modalités d'évaluation et les éventuels supports ou bilans sont précisés dans le programme convenu pour votre équipe.</p></details>
    </div>
  </div></section>
  <section class="section-space" id="contact"><div class="shell contact-panel"><div><div class="eyebrow">Parlons de votre projet</div><h2>Quelle est votre prochaine étape ?</h2><p>Une formation, un besoin commercial ou un projet de numérique responsable : commençons par votre contexte.</p><ContactDetails /></div><ContactForm /></div></section>
</SiteLayout>
