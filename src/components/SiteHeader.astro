---
import { siteConfig } from "@/config/site";
import Brand from "@/components/Brand.astro";

const links = [
  { href: "/services/", label: "Services" },
  { href: "/formations/", label: "Formations" },
  { href: "/experts/", label: "Experts & méthode" },
  { href: "/a-propos/", label: "À propos" },
  { href: "/contact/", label: "Contact" },
];
---

<a class="skip-link" href="#contenu">Aller au contenu</a>
{siteConfig.preview && <div class="preview-ribbon">Version de travail · DIORI GROWTH · envoi par email désactivé</div>}
<header class="site-header">
  <div class="shell header-inner">
    <Brand />
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Ouvrir le menu">
      <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <nav id="primary-navigation" class="nav-links" aria-label="Navigation principale" data-open="false">
      {links.map((link) => <a href={link.href} aria-current={Astro.url.pathname.startsWith(link.href) ? "page" : undefined}>{link.label}</a>)}
    </nav>
    <a class="button button-primary header-cta" href="/contact/">Parler de votre besoin <span aria-hidden="true">↗</span></a>
  </div>
</header>
