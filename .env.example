# Set only after owner approval and domain verification.
PUBLIC_SITE_URL=
PUBLIC_SITE_PREVIEW=false

# Phone and WhatsApp confirmed by the owner.
PUBLIC_CONTACT_PHONE=+22790323133
PUBLIC_CONTACT_PHONE_CONFIRMED=true
# The contact mailbox does not exist yet (confirmed 2026-10-14).
PUBLIC_CONTACT_EMAIL_CONFIRMED=false
PUBLIC_CONTACT_FORM_ENABLED=false
PUBLIC_PRIVACY_POLICY_URL=/documents/confidentialite/
PUBLIC_PRIVACY_POLICY_APPROVED=false

# Resend server-side delivery. Never expose these values to the browser.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_SEND_ENABLED=false

# Turnstile anti-spam verification (both values are required to enable sending).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
